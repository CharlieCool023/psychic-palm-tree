# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Firebase ────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=    # Firebase web API key (safe to expose in browser)
FIREBASE_API_KEY=         # Same key, used by seed script

# Optional frontend API base URL when the frontend is hosted separately.
# Example: VITE_API_URL=https://nyscondoeval.vercel.app
VITE_API_URL=

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator
