{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist/public",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app/api/[...slug].ts"
    },
    {
      "src": "/(.*)",
      "dest": "/app/dist/public/$1"
    }
  ]
}
